# Database
DATABASE_URL=postgresql://aptiverse:aptiverse123@db:5432/aptiverse_db

# JWT Secret
SECRET_KEY=your-secret-key-change-in-production

# Gmail SMTP
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Redis (Celery broker + ML cache + battle state)
REDIS_URL=redis://localhost:6379/0

# ChromaDB Settings
USE_CHROMA_CLOUD=true
CHROMA_API_KEY=your-chroma-api-key
CHROMA_TENANT=your-chroma-tenant
CHROMA_DATABASE=aptiverse
# Only used if USE_CHROMA_CLOUD is false
CHROMA_PERSIST_DIR=/app/chroma_db

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:3000

# Optional: Skip email verification (development only)
SKIP_EMAIL_VERIFICATION=false