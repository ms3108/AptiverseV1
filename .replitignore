# Replit Ignore File
# Similar to .gitignore but for Replit

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (use Secrets instead)
.env
.env.local
.env.production

# Build outputs
frontend/build/
dist/
*.egg-info/

# IDEs
.vscode/
.idea/

# Database
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Replit specific
.upm/
.cache/
.config/
.local/

# Git
.git/
.gitignore

# Deployment
.vercel/
*.log
